# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# YouTube API credentials & tokens
client_secret.json
.youtube-token.json
video-assets/store/youtube-upload-state.json

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# repository video rendering intermediates
/video-assets/repositories/*/audio/
/video-assets/repositories/*/segments/
/video-assets/repositories/*/rendered-slides/
/video-assets/repositories/**/*.inspect.ndjson

# 作業中に置いた一時ファイル。他サイトの本番 .env を持ち込んで
# 置きっぱなしにしたことがあるので、名前の形で丸ごと除外する。
.tmp_*
tsconfig.tsbuildinfo
