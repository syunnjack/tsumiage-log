{
  "name": "tsumiage-log",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "content:collect": "node scripts/collect-github-repositories.mjs",
    "content:localize": "node scripts/localize-repository-content.mjs",
    "content:audit": "node scripts/content-audit.mjs",
    "manual:audit": "node scripts/manual-article-audit.mjs",
    "copy:audit": "node scripts/reader-first-copy-audit.mjs",
    "manual:new": "node scripts/new-manual-article.mjs",
    "content:update": "npm run content:collect && npm run video:queue && npm run content:audit && npm run manual:audit && npm run copy:audit && npm run video:audit && npm run video:assets:audit && npm run lint && npm run build",
    "video:audit": "node scripts/video-audit.mjs",
    "video:assets:audit": "node scripts/repository-video-assets-audit.mjs",
    "video:assets:complete": "node scripts/repository-video-assets-audit.mjs --require-complete",
    "video:queue": "node scripts/build-video-production-queue.mjs",
    "video:render": "powershell -ExecutionPolicy Bypass -File scripts/render-repository-video.ps1",
    "video:batch": "powershell -ExecutionPolicy Bypass -File scripts/render-video-batch.ps1",
    "video:prepare-publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-video-publication.ps1",
    "video:status": "node scripts/update-video-status.mjs",
    "video:upload": "node scripts/upload-to-youtube.mjs",
    "video:upload:dry-run": "node scripts/upload-to-youtube.mjs --dry-run"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^174.0.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
